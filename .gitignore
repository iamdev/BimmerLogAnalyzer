.gradle/
build/
**/build/
local.properties
*.iml

# Android
*.apk
*.aab
*.ap_
*.dex
captures/
.externalNativeBuild/
.cxx/

# Android credentials — do NOT commit
app/google-services.json
app/src/main/res/raw/msal_config.json

# IDE
.idea/
*.iws
.DS_Store
Thumbs.db

# Keystore — release keys must never be committed, but the shared DEBUG
# keystore IS committed so all builds sign identically (updatable installs).
*.jks
*.keystore
!app/debug.keystore
